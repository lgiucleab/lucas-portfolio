# Environment variables the project uses. This file holds no real values and is safe to commit.
# To run locally: copy it to a file named .env (never committed) and fill in the values.
# On Vercel, set the same names under Project > Settings > Environment Variables.

# GitHub token for the build-time repo fetch (Phase 6).
# Use a fine-grained token: read-only, limited to the repos shown on the site.
# Without it, public repos still work but the rate limit is lower and private repos are missing.
GITHUB_TOKEN=

# Resend API key, used to email contact form messages (Phase 8).
RESEND_API_KEY=

# Inbox that receives contact form messages. Must be the Resend account email until a domain is verified.
CONTACT_TO_EMAIL=

# Sender address for those emails. Resend's shared address works without a domain.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Upstash Redis connection, used to rate limit the contact form (Phase 8).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
