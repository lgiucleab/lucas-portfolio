---
// Root page at "/". It holds no content: it only sends visitors to /en/ or /es/.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Lucas Giuclea Balan</title>
    <!-- Only the /en/ and /es/ pages should appear in search results. -->
    <meta name="robots" content="noindex" />
    <!-- Without JavaScript, the browser goes straight to the English site. -->
    <noscript>
      <meta http-equiv="refresh" content="0; url=/en/" />
    </noscript>
    <!-- is:inline runs this immediately, before anything is drawn. -->
    <script is:inline>
      (function () {
        const STORAGE_KEY = "language";
        let language = null;

        // Storage can be blocked, which makes every visit count as a first visit.
        try {
          language = localStorage.getItem(STORAGE_KEY);
        } catch {
          language = null;
        }

        // First visit: use the browser's preferred language, then remember the result.
        if (language !== "en" && language !== "es") {
          const preferred = navigator.languages ?? [navigator.language];
          language = preferred[0]?.toLowerCase().startsWith("es") ? "es" : "en";
          try {
            localStorage.setItem(STORAGE_KEY, language);
          } catch {
            // Nothing to do: the redirect below still works.
          }
        }

        // replace() keeps "/" out of history, so the Back button is not trapped here.
        location.replace("/" + language + "/");
      })();
    </script>
  </head>
  <body>
    <a href="/en/">English</a> · <a href="/es/">Español</a>
  </body>
</html>
