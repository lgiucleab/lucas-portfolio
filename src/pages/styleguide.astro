---
// TEMPORARY page showing every design token and base component for approval.
// Delete this file before launch (Phase 10). It is not linked from the site.
import "@/styles/global.css";
import ThemeScript from "@/components/layout/ThemeScript.astro";
import ThemeSwitcher from "@/components/layout/ThemeSwitcher.astro";
import BackgroundCircle from "@/components/ui/BackgroundCircle.astro";
import Button from "@/components/ui/Button.astro";
import Card from "@/components/ui/Card.astro";
import IconButton from "@/components/ui/IconButton.astro";
import SectionLabel from "@/components/ui/SectionLabel.astro";
import Tag from "@/components/ui/Tag.astro";

// Each swatch shows one color token. "border" outlines colors close to the page color.
const colors = [
  { name: "page", className: "bg-page border border-line" },
  { name: "surface", className: "bg-surface border border-line" },
  { name: "ink", className: "bg-ink" },
  { name: "muted", className: "bg-muted" },
  { name: "line", className: "bg-line" },
  { name: "accent", className: "bg-accent" },
  { name: "on-accent", className: "bg-on-accent border border-line" },
];

const radii = [
  { name: "rounded-card", className: "rounded-card" },
  { name: "rounded-panel", className: "rounded-panel" },
  { name: "rounded-full", className: "rounded-full" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Keeps this temporary page out of search engines. -->
    <meta name="robots" content="noindex" />
    <title>Styleguide</title>
    <ThemeScript />
  </head>
  <body>
    <div class="relative overflow-hidden">
      <BackgroundCircle class="-top-24 -right-24 size-[28rem]" />
      <BackgroundCircle class="top-[60rem] -left-40 size-[32rem]" />

      <main class="max-w-page px-gutter relative mx-auto space-y-20 py-16">
        <header class="flex flex-wrap items-center justify-between gap-4">
          <p class="font-display text-ink">Styleguide</p>
          <ThemeSwitcher />
        </header>

        <section class="space-y-6">
          <SectionLabel>Typography</SectionLabel>
          <h1 class="text-display leading-none font-semibold">Developer</h1>
          <p class="text-title font-display text-ink leading-tight font-semibold">Articles</p>
          <h3 class="text-xl">Heading 3 in Fira Code</h3>
          <h4 class="text-base">Heading 4 in Fira Code</h4>
          <p class="max-w-text text-lg">
            Body text in Open Sans, with key words like <em>Computer Science student</em> and{" "}
            <em>Universitat Jaume I</em> shown in italics. Acentos en español: año, información,
            Comunidad Valenciana.
          </p>
        </section>

        <section class="space-y-6">
          <SectionLabel>Colors</SectionLabel>
          <ul class="grid grid-cols-2 gap-4 sm:grid-cols-4 lg:grid-cols-7">
            {colors.map((color) => (
              <li class="space-y-2">
                <div class:list={["rounded-card h-24", color.className]} />
                <p class="font-display text-xs">{color.name}</p>
              </li>
            ))}
          </ul>
        </section>

        <section class="space-y-6">
          <SectionLabel>Buttons</SectionLabel>
          <div class="flex flex-wrap items-center gap-4">
            <Button arrow>Primary</Button>
            <Button>No arrow</Button>
            <Button variant="outline">Outline</Button>
            <Button variant="outline" icon="simple-icons:github">
              GitHub
            </Button>
            <Button variant="outline" icon="simple-icons:linkedin" arrow>
              LinkedIn
            </Button>
            <IconButton icon="lucide:arrow-up-right" label="Open project" solid />
            <IconButton icon="lucide:arrow-left" label="Previous" />
          </div>
        </section>

        <section class="space-y-6">
          <SectionLabel>Tags</SectionLabel>
          <div class="flex flex-wrap gap-2">
            <Tag>TypeScript</Tag>
            <Tag>Astro</Tag>
            <Tag icon="simple-icons:python">Python</Tag>
            <Tag icon="simple-icons:javascript">JavaScript</Tag>
          </div>
        </section>

        <section class="space-y-6">
          <SectionLabel>Cards</SectionLabel>
          <div class="grid gap-4 md:grid-cols-2">
            <Card as="article" interactive class="space-y-4">
              <h3 class="text-xl font-medium">Interactive card</h3>
              <p>Hover it: the border brightens. Used for blog posts and links.</p>
              <Button arrow>Read more</Button>
            </Card>
            <Card as="article" class="space-y-4">
              <h3 class="text-xl font-medium">Static card</h3>
              <p>Plain version for content with no single link.</p>
              <div class="flex flex-wrap gap-2">
                <Tag>Git</Tag>
                <Tag>Vercel</Tag>
              </div>
            </Card>
          </div>
        </section>

        <section class="space-y-6">
          <SectionLabel>Radius</SectionLabel>
          <ul class="flex flex-wrap gap-4">
            {radii.map((radius) => (
              <li class="space-y-2">
                <div class:list={["border-line size-28 border", radius.className]} />
                <p class="font-display text-xs">{radius.name}</p>
              </li>
            ))}
          </ul>
        </section>
      </main>
    </div>
  </body>
</html>
