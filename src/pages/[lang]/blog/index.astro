---
// Blog list page, built once per language. Posts come from src/content/blog/<language>/
import type { GetStaticPaths } from "astro";

import Button from "@/components/ui/Button.astro";
import Tag from "@/components/ui/Tag.astro";
import type { Locale } from "@/i18n/config";
import { getLocaleStaticPaths, localizedPath, useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPostSlug, getPublishedPosts, getReadingMinutes } from "@/lib/content";
import { formatFullDate } from "@/lib/dates";

export const getStaticPaths = (() => getLocaleStaticPaths()) satisfies GetStaticPaths;

// getStaticPaths only creates pages for valid languages, so this cast is safe.
const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);
const posts = await getPublishedPosts(locale);
---

<BaseLayout locale={locale} title={t("meta.blogTitle")} description={t("meta.blogDescription")}>
  <section class="max-w-page px-gutter py-section mx-auto space-y-12">
    <h1 class="text-title leading-none font-medium">{t("nav.blog")}</h1>

    {posts.length === 0 ? (
      <p>{t("blog.empty")}</p>
    ) : (
      // Posts as hairline rows: date on the left, title and summary on the right.
      <div class="border-line border-t">
        {posts.map((post) => (
          <article class="reveal border-line grid gap-3 border-b py-8 sm:grid-cols-[11rem_minmax(0,1fr)] sm:gap-8">
            <p class="font-mono text-xs">
              <time datetime={post.data.date.toISOString().slice(0, 10)}>
                {formatFullDate(post.data.date, locale)}
              </time>
              <span class="block">{`${getReadingMinutes(post)} ${t("blog.minutes")}`}</span>
            </p>
            <div class="space-y-3">
              <h2 class="text-2xl font-medium">
                {/* The title is the link; the hover color shows it is clickable. */}
                <a
                  href={localizedPath(locale, `blog/${getPostSlug(post)}`)}
                  class="hover:text-highlight transition-colors"
                >
                  {post.data.title}
                </a>
              </h2>
              <p class="max-w-text">{post.data.description}</p>
              {post.data.tags.length > 0 && (
                <ul class="flex flex-wrap gap-2">
                  {post.data.tags.map((tag) => (
                    <li>
                      <Tag>{tag}</Tag>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </article>
        ))}
      </div>
    )}

    <Button variant="outline" href={`${localizedPath(locale)}rss.xml`} icon="lucide:rss">
      {t("blog.rss")}
    </Button>
  </section>
</BaseLayout>
