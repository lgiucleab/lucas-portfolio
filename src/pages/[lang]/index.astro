---
// Home page, built once per language. To reorder the page, reorder the components below.
import type { GetStaticPaths } from "astro";

import About from "@/components/sections/About.astro";
import Contact from "@/components/sections/Contact.astro";
import Hero from "@/components/sections/Hero.astro";
import Projects from "@/components/sections/Projects.astro";
import Skills from "@/components/sections/Skills.astro";
import Timeline from "@/components/sections/Timeline.astro";
import type { Locale } from "@/i18n/config";
import { getLocaleStaticPaths, useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";

export const getStaticPaths = (() => getLocaleStaticPaths()) satisfies GetStaticPaths;

// getStaticPaths only creates pages for valid languages, so this cast is safe.
const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);
---

<BaseLayout locale={locale} title={t("meta.title")} description={t("meta.description")}>
  <Hero locale={locale} />
  <Timeline locale={locale} />
  <Projects locale={locale} />
  <Skills locale={locale} />
  <About locale={locale} />
  <Contact locale={locale} />
</BaseLayout>
