---
// Home page, built once per language. To reorder the page, reorder the components below.
import type { GetStaticPaths } from "astro";

import About from "@/components/sections/About.astro";
import Hero from "@/components/sections/Hero.astro";
import Projects from "@/components/sections/Projects.astro";
import Skills from "@/components/sections/Skills.astro";
import Timeline from "@/components/sections/Timeline.astro";
import Section from "@/components/ui/Section.astro";
import SectionLabel from "@/components/ui/SectionLabel.astro";
import type { Locale } from "@/i18n/config";
import { getLocaleStaticPaths, useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";

export const getStaticPaths = (() => getLocaleStaticPaths()) satisfies GetStaticPaths;

// getStaticPaths only creates pages for valid languages, so this cast is safe.
const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);
---

<BaseLayout locale={locale} title={t("meta.title")} description={t("meta.description")}>
  <Hero locale={locale} />
  <Timeline locale={locale} />
  <Projects locale={locale} />
  <Skills locale={locale} />
  <About locale={locale} />
  <!-- Temporary shell, so the Contact links work. Phase 8 replaces it. -->
  <Section id="contact" class="space-y-6">
    <SectionLabel>{t("nav.contact")}</SectionLabel>
    <p>{t("placeholder.contact")}</p>
  </Section>
</BaseLayout>
