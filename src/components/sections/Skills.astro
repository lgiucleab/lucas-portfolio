---
// Skills as hairline rows: the group name on the left, its skills on the right.
// The data lives in src/config/skills.ts
import Section from "@/components/ui/Section.astro";
import Tag from "@/components/ui/Tag.astro";
import { skillGroups } from "@/config/skills";
import type { Locale } from "@/i18n/config";
import { useTranslations } from "@/i18n";

interface Props {
  // The language of the current page.
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Section id="skills" label={t("skills.title")} number="03">
  <div class="border-line border-t">
    {skillGroups.map((group) => (
      <div class="reveal border-line grid gap-4 border-b py-6 sm:grid-cols-[11rem_minmax(0,1fr)] sm:gap-8">
        <h3 class="text-base font-medium">{t(group.title)}</h3>
        <ul class="flex flex-wrap gap-2">
          {group.skills.map((skill) => (
            <li>
              <Tag icon={skill.icon}>
                {skill.name}
                {skill.note && ` (${t(skill.note)})`}
              </Tag>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</Section>
