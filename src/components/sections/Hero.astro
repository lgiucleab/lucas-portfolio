---
// First section: photo, availability badge, greeting, intro text and main buttons.
import { render } from "astro:content";

import Button from "@/components/ui/Button.astro";
import Photo from "@/components/ui/Photo.astro";
import Section from "@/components/ui/Section.astro";
import { site } from "@/config/site";
import type { Locale } from "@/i18n/config";
import { localizedPath, useTranslations } from "@/i18n";
import { getProfileEntry } from "@/lib/content";

interface Props {
  // The language of the current page.
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// The intro text lives in src/content/profile/<language>/hero.md
const { Content: Intro } = await render(await getProfileEntry("hero", locale));

// LinkedIn and GitHub buttons, in this order, taken from the shared social list.
const heroLinks = ["LinkedIn", "GitHub"].flatMap((label) =>
  site.socials.filter((social) => social.label === label),
);
const linkedin = heroLinks[0];

// The CV button only appears once this language's PDF exists in public/cv/, so it can
// never lead to a missing file. The glob just lists the files found there.
const cvFiles = import.meta.glob("/public/cv/*.pdf", { query: "?url" });
const cvPath = `/public/cv/cv-${locale}.pdf`;
const hasCv = cvPath in cvFiles;
---

<Section id="hero" class="flex min-h-[calc(85dvh-5rem)] flex-col justify-end gap-10">
  <div class="flex flex-wrap items-center gap-4">
    <Photo name="avatar" alt={t("photo.avatar")} width={160} class="size-14 rounded-full" />
    <a
      href={linkedin?.href}
      target="_blank"
      rel="noopener noreferrer"
      class="text-ink hover:text-highlight inline-flex items-center gap-2 font-mono text-xs transition-colors"
    >
      <!-- Small dot with a soft pulse, like a live status light. -->
      <span aria-hidden="true" class="relative flex size-2">
        <span class="bg-highlight absolute size-full rounded-full motion-safe:animate-ping"></span>
        <span class="bg-highlight relative size-2 rounded-full"></span>
      </span>
      {t("hero.badge")}
    </a>
  </div>

  <!-- The name is an <em>, so it takes the serif italic and the warm highlight color. -->
  <h1 class="text-display leading-[0.95] font-medium tracking-[-0.045em]">
    {t("hero.greeting")} <em>Lucas</em>
  </h1>

  <div class="max-w-text text-lg leading-relaxed">
    <Intro />
  </div>

  <div class="flex flex-wrap items-center gap-3">
    <Button href={localizedPath(locale, "", "contact")} arrow>
      {t("hero.contact")}
    </Button>
    {heroLinks.map((social) => (
      <Button variant="outline" href={social.href} icon={social.icon} external>
        {social.label}
      </Button>
    ))}
    {hasCv && (
      <Button
        variant="outline"
        href={cvPath.replace("/public", "")}
        icon="lucide:download"
        download
      >
        {t("hero.downloadCv")}
      </Button>
    )}
  </div>
</Section>
