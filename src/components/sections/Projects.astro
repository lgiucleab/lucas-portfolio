---
// Featured projects plus the "More on GitHub" list.
// Every file in src/content/projects/<language>/ becomes one featured project here.
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { render } from "astro:content";

import BackgroundCircle from "@/components/ui/BackgroundCircle.astro";
import Button from "@/components/ui/Button.astro";
import Card from "@/components/ui/Card.astro";
import Section from "@/components/ui/Section.astro";
import SectionLabel from "@/components/ui/SectionLabel.astro";
import Tag from "@/components/ui/Tag.astro";
import { site } from "@/config/site";
import { techIcons } from "@/config/tech-icons";
import type { Locale } from "@/i18n/config";
import { useTranslations } from "@/i18n";
import { getLocalizedEntries } from "@/lib/content";
import { formatMonth } from "@/lib/dates";
import { getGitHubData } from "@/lib/github";

interface Props {
  // The language of the current page.
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// Lower "order" values come first.
const entries = await getLocalizedEntries("projects", locale);
entries.sort((a, b) => a.data.order - b.data.order);

// render() prepares each project's description text for display.
const rendered = await Promise.all(entries.map((entry) => render(entry)));

// Live repository details, or saved ones if GitHub could not be reached.
const github = await getGitHubData();
const githubProfile = site.socials.find((social) => social.label === "GitHub");
---

<Section id="projects" class="space-y-16">
  <BackgroundCircle slot="background" class="top-1/3 -right-48 size-[36rem]" />
  <SectionLabel>{t("projects.title")}</SectionLabel>

  {entries.map((entry, index) => {
    const Description = rendered[index]?.Content;
    const { title, repo, private: isPrivate, tags, image, preview } = entry.data;
    const repoData = github.featured[repo];

    // Details written in the content file win. GitHub fills in what was left out.
    const shownTags =
      tags.length > 0
        ? tags
        : [...(repoData?.languages.slice(0, 3) ?? []), ...(repoData?.topics ?? [])].slice(0, 5);
    const previewUrl = preview ?? (repoData?.homepage || undefined);
    const hasDescription = Boolean(entry.body?.trim());

    return (
      <article class="reveal grid items-center gap-8 lg:grid-cols-2 lg:gap-16">
        {/* Every second project swaps sides on wide screens, as in the design. */}
        <div class:list={["min-w-0", index % 2 === 1 && "lg:order-last"]}>
          {image ? (
            <Image
              src={image}
              alt={title}
              width={720}
              class="rounded-panel aspect-[16/10] w-full object-cover"
            />
          ) : (
            <div
              aria-hidden="true"
              class="rounded-panel border-line bg-surface font-display text-ink relative flex aspect-[16/10] items-center justify-center overflow-hidden border text-2xl sm:text-4xl"
            >
              <BackgroundCircle class="-right-16 -bottom-24 size-72" />
              {title}
            </div>
          )}
        </div>

        <div class="min-w-0 space-y-5">
          <h3 class="text-2xl font-medium">{title}</h3>
          <ul class="flex flex-wrap gap-2">
            {isPrivate && (
              <li>
                <Tag icon="lucide:lock">{t("projects.private")}</Tag>
              </li>
            )}
            {shownTags.map((tag) => (
              <li>{techIcons[tag] ? <Tag icon={techIcons[tag]}>{tag}</Tag> : <Tag>{tag}</Tag>}</li>
            ))}
          </ul>
          <div>
            {hasDescription && Description ? <Description /> : <p>{repoData?.description}</p>}
          </div>
          {repoData && (
            <p class="flex flex-wrap items-center gap-4 text-sm">
              {repoData.stars > 0 && (
                <span class="inline-flex items-center gap-1">
                  <Icon name="lucide:star" class="size-4" aria-hidden="true" />
                  <span class="sr-only">{t("projects.stars")}:</span>
                  {repoData.stars}
                </span>
              )}
              <span>
                {t("projects.updated")}: {formatMonth(new Date(repoData.updatedAt), locale)}
              </span>
            </p>
          )}
          {(!isPrivate || previewUrl) && (
            <div class="flex flex-wrap gap-3">
              {!isPrivate && (
                <Button
                  variant="outline"
                  href={`${githubProfile?.href}/${repo}`}
                  icon="simple-icons:github"
                  external
                >
                  {t("projects.code")}
                </Button>
              )}
              {previewUrl && (
                <Button href={previewUrl} external arrow>
                  {t("projects.preview")}
                </Button>
              )}
            </div>
          )}
        </div>
      </article>
    );
  })}

  <div class="space-y-6">
    {github.recent.length > 0 && (
      <>
        <h3 class="text-xl font-medium">{t("projects.moreTitle")}</h3>
        <ul class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {github.recent.map((repo) => (
            <Card as="li" interactive class="reveal space-y-3">
              <h4 class="break-words">
                <a
                  href={repo.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:underline"
                >
                  {repo.name}
                </a>
              </h4>
              {repo.description && <p class="text-sm">{repo.description}</p>}
              <p class="flex flex-wrap items-center gap-4 text-sm">
                {repo.languages[0] && <span>{repo.languages[0]}</span>}
                {repo.stars > 0 && (
                  <span class="inline-flex items-center gap-1">
                    <Icon name="lucide:star" class="size-4" aria-hidden="true" />
                    <span class="sr-only">{t("projects.stars")}:</span>
                    {repo.stars}
                  </span>
                )}
              </p>
            </Card>
          ))}
        </ul>
      </>
    )}
    <Button variant="outline" href={githubProfile?.href} icon="simple-icons:github" external>
      {t("projects.viewAll")}
    </Button>
  </div>
</Section>
