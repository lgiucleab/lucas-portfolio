---
// About section: personal text beside a second photo.
import { render } from "astro:content";

import Photo from "@/components/ui/Photo.astro";
import Section from "@/components/ui/Section.astro";
import type { Locale } from "@/i18n/config";
import { useTranslations } from "@/i18n";
import { getProfileEntry } from "@/lib/content";

interface Props {
  // The language of the current page.
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// The text lives in src/content/profile/<language>/about.md
const { Content: AboutText } = await render(await getProfileEntry("about", locale));
---

<Section id="about" label={t("about.title")} number="04">
  <div class="grid items-start gap-10 md:grid-cols-[3fr_2fr] lg:gap-16">
    <!-- Larger, darker text than elsewhere: this is the personal part of the page. -->
    <div class="text-ink space-y-5 text-xl leading-relaxed">
      <AboutText />
    </div>
    <Photo
      name="about"
      alt={t("photo.about")}
      width={560}
      class="rounded-panel mx-auto aspect-[4/5] w-full max-w-sm text-4xl"
    />
  </div>
</Section>
