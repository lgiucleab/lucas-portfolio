---
// Contact section: email with a copy button, social links and the contact form.
// The form sends through the "contact" action in src/actions/index.ts
import { Icon } from "astro-icon/components";

import BackgroundCircle from "@/components/ui/BackgroundCircle.astro";
import Button from "@/components/ui/Button.astro";
import Card from "@/components/ui/Card.astro";
import Section from "@/components/ui/Section.astro";
import SectionLabel from "@/components/ui/SectionLabel.astro";
import { site } from "@/config/site";
import type { Locale } from "@/i18n/config";
import { useTranslations } from "@/i18n";

interface Props {
  // The language of the current page.
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// Shared look of the text fields. The stronger border keeps them easy to see.
const fieldClasses =
  "border-field text-ink bg-transparent aria-[invalid=true]:border-ink w-full rounded-2xl border px-4 py-3 aria-[invalid=true]:border-2";

// The visible fields, so that each one is built the same way.
const fields = [
  { name: "name", label: t("contact.name"), type: "text", autocomplete: "name" },
  { name: "email", label: t("contact.email"), type: "email", autocomplete: "email" },
] as const;
---

<Section id="contact" class="space-y-12">
  <BackgroundCircle slot="background" class="-top-24 -right-40 size-[30rem]" />
  <SectionLabel>{t("nav.contact")}</SectionLabel>

  <div class="grid gap-10 lg:grid-cols-[2fr_3fr] lg:gap-16">
    <div class="space-y-6">
      <p class="text-lg">{t("contact.intro")}</p>

      <div class="flex flex-wrap items-center gap-3">
        <a href={`mailto:${site.email}`} class="text-ink break-all underline underline-offset-4">
          {site.email}
        </a>
        <button
          type="button"
          data-copy-email={site.email}
          data-label-copy={t("contact.copyEmail")}
          data-label-copied={t("contact.copied")}
          class="border-line text-ink hover:border-ink inline-flex min-h-9 items-center gap-2 rounded-full border px-3 text-xs italic transition-colors"
        >
          <Icon name="lucide:copy" class="size-3.5" aria-hidden="true" />
          <span data-copy-text aria-live="polite">
            {t("contact.copyEmail")}
          </span>
        </button>
      </div>

      <ul aria-label={t("footer.social")} class="flex flex-wrap gap-3">
        {site.socials.map((social) => (
          <li>
            <Button variant="outline" href={social.href} icon={social.icon} external>
              {social.label}
            </Button>
          </li>
        ))}
      </ul>
    </div>

    <Card>
      <noscript>
        <p class="mb-4">{t("contact.noScript")}</p>
      </noscript>

      <!-- noValidate replaces the browser's messages with translated ones. -->
      <form
        data-contact-form
        novalidate
        class="space-y-5"
        data-error-required={t("contact.errorRequired")}
        data-error-invalid-email={t("contact.errorInvalidEmail")}
        data-error-too-short={t("contact.errorTooShort")}
        data-error-too-long={t("contact.errorTooLong")}
        data-message-success={t("contact.success")}
        data-message-rate-limit={t("contact.errorRateLimit")}
        data-message-failure={t("contact.errorFailure")}
        data-label-send={t("contact.send")}
        data-label-sending={t("contact.sending")}
      >
        {fields.map((field) => (
          <div class="space-y-2">
            <label for={`contact-${field.name}`} class="text-ink block text-sm">
              {field.label}
            </label>
            <input
              id={`contact-${field.name}`}
              name={field.name}
              type={field.type}
              autocomplete={field.autocomplete}
              required
              aria-describedby={`contact-${field.name}-error`}
              class={fieldClasses}
            />
            <p
              id={`contact-${field.name}-error`}
              data-field-error={field.name}
              class="text-ink text-sm italic"
            ></p>
          </div>
        ))}

        <div class="space-y-2">
          <label for="contact-message" class="text-ink block text-sm">
            {t("contact.message")}
          </label>
          <textarea
            id="contact-message"
            name="message"
            rows="6"
            required
            aria-describedby="contact-message-error"
            class:list={[fieldClasses, "resize-y"]}
          ></textarea>
          <p
            id="contact-message-error"
            data-field-error="message"
            class="text-ink text-sm italic"
          ></p>
        </div>

        <!-- Honeypot: moved off screen and skipped by keyboard and screen readers. -->
        <div aria-hidden="true" class="absolute -left-[9999px]">
          <label for="contact-website">{t("contact.honeypot")}</label>
          <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="flex flex-wrap items-center gap-4">
          <Button type="submit" arrow class="disabled:cursor-wait disabled:opacity-60">
            <span data-submit-label>{t("contact.send")}</span>
          </Button>
          <!-- role="status" makes screen readers announce the result. -->
          <p data-form-status role="status" class="text-ink text-sm"></p>
        </div>
      </form>
    </Card>
  </div>
</Section>

<script>
  import { actions, isInputError } from "astro:actions";

  // How long the "Copied" confirmation stays on the button.
  const CONFIRMATION_MS = 2000;

  // Field names mapped to their error codes.
  type FieldErrors = Record<string, string | undefined>;

  // Turns an error code like "tooLong" into its translated message.
  function translateError(form: HTMLFormElement, code: string | undefined): string {
    if (!code) return "";
    const key = `error${code.charAt(0).toUpperCase()}${code.slice(1)}`;
    return form.dataset[key] ?? form.dataset.errorRequired ?? "";
  }

  // Writes each field's error under it, and marks the field for screen readers.
  function showFieldErrors(form: HTMLFormElement, errors: FieldErrors) {
    form.querySelectorAll<HTMLElement>("[data-field-error]").forEach((element) => {
      const name = element.dataset.fieldError ?? "";
      const message = translateError(form, errors[name]);
      element.textContent = message;
      form
        .querySelector(`[name="${name}"]`)
        ?.setAttribute("aria-invalid", String(Boolean(message)));
    });

    // Moves keyboard focus to the first problem.
    form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
  }

  // Sends the form and shows the loading, success or error state.
  async function handleSubmit(form: HTMLFormElement) {
    const status = form.querySelector<HTMLElement>("[data-form-status]");
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const label = form.querySelector<HTMLElement>("[data-submit-label]");
    if (!status || !button || !label) return;

    const formData = new FormData(form);
    status.textContent = "";

    // Browser check, using the same rules as the server. The rules load on first use,
    // so visitors who never send the form do not download Zod.
    const { contactSchema } = await import("@/lib/contact-schema");
    const check = contactSchema.safeParse(Object.fromEntries(formData));
    if (!check.success) {
      const errors: FieldErrors = {};
      check.error.issues.forEach((issue) => {
        const name = String(issue.path[0]);
        errors[name] ??= issue.message;
      });
      showFieldErrors(form, errors);
      return;
    }
    showFieldErrors(form, {});

    button.disabled = true;
    label.textContent = form.dataset.labelSending ?? "";

    const { error } = await actions.contact(formData);

    button.disabled = false;
    label.textContent = form.dataset.labelSend ?? "";

    if (!error) {
      form.reset();
      status.textContent = form.dataset.messageSuccess ?? "";
    } else if (isInputError(error)) {
      const errors: FieldErrors = {};
      Object.entries(error.fields).forEach(([name, codes]) => (errors[name] = codes?.[0]));
      showFieldErrors(form, errors);
    } else if (error.code === "TOO_MANY_REQUESTS") {
      status.textContent = form.dataset.messageRateLimit ?? "";
    } else {
      status.textContent = form.dataset.messageFailure ?? "";
    }
  }

  // Copies the email address and briefly confirms it.
  function initCopyEmail() {
    const button = document.querySelector<HTMLButtonElement>("[data-copy-email]");
    const text = button?.querySelector("[data-copy-text]");
    if (!button || !text) return;

    button.addEventListener("click", async () => {
      // The browser can refuse clipboard access. The address stays selectable by hand.
      try {
        await navigator.clipboard.writeText(button.dataset.copyEmail ?? "");
      } catch {
        return;
      }
      text.textContent = button.dataset.labelCopied ?? "";
      setTimeout(() => (text.textContent = button.dataset.labelCopy ?? ""), CONFIRMATION_MS);
    });
  }

  function initContactForm() {
    const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      void handleSubmit(form);
    });
    initCopyEmail();
  }

  // Runs on the first load and after every View Transition.
  document.addEventListener("astro:page-load", initContactForm);
</script>
