---
// Standard page section: a hairline on top, the numbered label in a left column on
// wide screens, and the content on the right. Without a label (the hero), the
// content uses the full width.
import SectionLabel from "./SectionLabel.astro";

interface Props {
  // Anchor name. It must match the link in Header.astro.
  id: string;
  // Section title shown in the label column, such as "Projects".
  label?: string;
  // Two-digit position shown before the label, such as "02".
  number?: string;
  // Extra Tailwind classes for the content area.
  class?: string;
}

const { id, label, number, class: className } = Astro.props;
---

<section id={id} class:list={[label && "border-line border-t"]}>
  <div
    class:list={[
      "max-w-page px-gutter py-section mx-auto",
      label && "grid gap-10 lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-16",
    ]}
  >
    {label && (
      // Sticky on wide screens, so the label stays beside long sections.
      <div class="lg:sticky lg:top-28 lg:self-start">
        <SectionLabel number={number}>{label}</SectionLabel>
      </div>
    )}
    <div class:list={["min-w-0", className]}>
      <slot />
    </div>
  </div>
</section>
