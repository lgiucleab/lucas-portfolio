---
// Pill button. Renders a link when given href, otherwise a <button>.
// The button text goes between the tags: <Button href="/en/blog">Read more</Button>
import { Icon } from "astro-icon/components";

interface Props {
  // "primary" is the solid pill; "outline" is the thin bordered pill.
  variant?: "primary" | "outline";
  // Where to go. Without it, a real <button> is rendered.
  href?: string;
  // Opens the link in a new tab, for sites outside the portfolio.
  external?: boolean;
  // Saves the linked file instead of opening it.
  download?: boolean;
  // Button behaviour inside a form. Ignored for links.
  type?: "button" | "submit";
  // Iconify name shown before the text, such as "simple-icons:github".
  icon?: string;
  // Adds an arrow after the text that slides on hover.
  arrow?: boolean;
  // Extra Tailwind classes from the parent.
  class?: string;
}

const {
  variant = "primary",
  href,
  external = false,
  download = false,
  type = "button",
  icon,
  arrow = false,
  class: className,
} = Astro.props;

// Link-only attributes. rel protects the opener page when opening a new tab.
const linkAttributes = {
  ...(external ? { target: "_blank", rel: "noopener noreferrer" } : {}),
  ...(download ? { download: true } : {}),
};
const Element = href ? "a" : "button";
const elementAttributes = href ? { href, ...linkAttributes } : { type };
---

<Element
  {...elementAttributes}
  class:list={[
    // min-h-11 keeps the touch target at 44px.
    "group inline-flex min-h-11 items-center justify-center gap-2 rounded-full px-5 text-sm font-medium transition-colors",
    variant === "primary"
      ? "bg-accent text-on-accent hover:bg-highlight hover:text-page"
      : "border-line text-ink hover:border-ink border",
    className,
  ]}
>
  {icon && <Icon name={icon} class="size-4" aria-hidden="true" />}
  <slot />
  {arrow && (
    <Icon
      name={external ? "lucide:arrow-up-right" : "lucide:arrow-right"}
      class="ease-soft size-4 transition-transform duration-300 group-hover:translate-x-0.5"
      aria-hidden="true"
    />
  )}
</Element>
