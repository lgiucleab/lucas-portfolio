---
// Small label for a technology name, such as "TypeScript". The text goes between the tags.
import { Icon } from "astro-icon/components";

interface Props {
  // Optional Iconify name shown before the text.
  icon?: string;
}

const { icon } = Astro.props;
---

<span class="bg-surface text-ink inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 font-mono text-xs">
  {icon && <Icon name={icon} class="size-3.5" aria-hidden="true" />}
  <slot />
</span>
