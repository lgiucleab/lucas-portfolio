---
// Section heading in the editorial style: a small mono number, then the title.
// Write only the title between the tags: <SectionLabel number="02">Projects</SectionLabel>

interface Props {
  // Two-digit position in the page, such as "02". Optional.
  number?: string;
  // Heading level, so the page outline stays correct.
  as?: "h2" | "h3";
}

const { number, as: Element = "h2" } = Astro.props;
---

<Element class="flex items-baseline gap-3 text-base font-medium">
  {/* The number is decoration, so screen readers skip it. */}
  {number && (
    <span aria-hidden="true" class="text-muted font-mono text-xs">
      {number}
    </span>
  )}
  <span>
    <slot />
  </span>
</Element>
