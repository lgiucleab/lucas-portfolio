---
// All <head> tags for search engines and social previews.
import { defaultLocale, locales, type Locale } from "@/i18n/config";
import { localizedPath, pathWithoutLocale } from "@/i18n";
import { site } from "@/config/site";

interface Props {
  // The language of this page.
  locale: Locale;
  // Translated page title.
  title: string;
  // Translated page description.
  description: string;
  // Preview image path, such as "/og/en/home.png".
  image: string;
  // "article" for blog posts, "website" for everything else.
  type?: "website" | "article";
}

const { locale, title, description, image, type = "website" } = Astro.props;

// Social sites expect language codes in this format.
const openGraphLocales: Record<Locale, string> = { en: "en_GB", es: "es_ES" };

// The same page in each language, as a full address.
const path = pathWithoutLocale(Astro.url.pathname);
const absoluteUrl = (code: Locale) => new URL(localizedPath(code, path), Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
---

<title>{title}</title>
<meta name="description" content={description} />

<!-- Tells search engines the main address, and where each translation lives. -->
<link rel="canonical" href={absoluteUrl(locale)} />
{locales.map((code) => (
  <link rel="alternate" hreflang={code} href={absoluteUrl(code)} />
))}
<link rel="alternate" hreflang="x-default" href={absoluteUrl(defaultLocale)} />

<!-- Open Graph: the preview on LinkedIn, WhatsApp, Discord and similar sites. -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={absoluteUrl(locale)} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={openGraphLocales[locale]} />
{locales
  .filter((code) => code !== locale)
  .map((code) => (
    <meta property="og:locale:alternate" content={openGraphLocales[code]} />
  ))}

<!-- The preview on X. It reuses the title, description and image from above. -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
