---
// JSON-LD structured data, which tells search engines who this site is about.
// It is only used on the home page.
import { site } from "@/config/site";
import type { Locale } from "@/i18n/config";
import { localizedPath, useTranslations } from "@/i18n";

interface Props {
  // The language of the current page.
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// Field names come from the Person type at https://schema.org/Person
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  url: new URL(localizedPath(locale), Astro.site).href,
  email: `mailto:${site.email}`,
  jobTitle: t("footer.role"),
  affiliation: { "@type": "CollegeOrUniversity", name: "Universitat Jaume I" },
  address: {
    "@type": "PostalAddress",
    addressRegion: "Comunidad Valenciana",
    addressCountry: "ES",
  },
  sameAs: site.socials.map((social) => social.href),
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(person)} />
