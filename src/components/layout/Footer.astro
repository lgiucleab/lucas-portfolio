---
// Site footer: a closing line with the contact link, social links, copyright, and the
// name set very large at the bottom like a magazine's back page.
import Button from "@/components/ui/Button.astro";
import { site } from "@/config/site";
import type { Locale } from "@/i18n/config";
import { localizedPath, useTranslations } from "@/i18n";

interface Props {
  // The language of the current page.
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// Set at build time. The daily rebuild keeps it correct.
const year = new Date().getFullYear();
---

<footer class="border-line overflow-hidden border-t">
  <div class="max-w-page px-gutter mx-auto space-y-12 pt-16 pb-8">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <p class="max-w-text text-lg">{t("footer.role")}</p>
      <Button href={localizedPath(locale, "", "contact")} arrow>
        {t("nav.contact")}
      </Button>
    </div>

    <!-- Plain text links: quieter than buttons, and they wrap well on phones. -->
    <ul aria-label={t("footer.social")} class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
      {site.socials.map((social) => (
        <li>
          <a
            href={social.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-ink hover:text-highlight inline-flex min-h-11 items-center gap-1 transition-colors"
          >
            {social.label}
            <span aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
      <li>
        <a
          href={`mailto:${site.email}`}
          class="text-ink hover:text-highlight inline-flex min-h-11 items-center transition-colors"
        >
          {t("footer.email")}
        </a>
      </li>
    </ul>

    <!-- The name fills the page width. It is decoration, because the header already names the site. -->
    <p
      aria-hidden="true"
      class="text-ink text-[clamp(3rem,13.5vw,11rem)] leading-[0.85] font-medium tracking-[-0.06em] whitespace-nowrap"
    >
      Lucas <em>Giuclea</em>
    </p>

    <p class="border-line border-t pt-6 font-mono text-xs">
      © {year} {site.name}. {t("footer.rights")}
    </p>
  </div>
</footer>
