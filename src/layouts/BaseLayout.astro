---
// Page frame used by every public page: <head>, header, main content area and footer.
// The page content goes between the tags.
import "@/styles/global.css";
import firaCodeFont from "@fontsource-variable/fira-code/files/fira-code-latin-wght-normal.woff2?url";
import openSansItalicFont from "@fontsource-variable/open-sans/files/open-sans-latin-wght-italic.woff2?url";
import openSansFont from "@fontsource-variable/open-sans/files/open-sans-latin-wght-normal.woff2?url";
import Analytics from "@vercel/analytics/astro";
import { ClientRouter } from "astro:transitions";

import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import ThemeScript from "@/components/layout/ThemeScript.astro";
import SEO from "@/components/seo/SEO.astro";
import type { Locale } from "@/i18n/config";
import { localizedPath, useTranslations } from "@/i18n";

interface Props {
  // The language of this page.
  locale: Locale;
  // Translated browser tab title and search result title.
  title: string;
  // Translated search result description.
  description: string;
  // Social preview image. Pages without their own use the home page image.
  image?: string;
  // "article" for blog posts.
  type?: "website" | "article";
}

const { locale, title, description, image = `/og/${locale}/home.png`, type } = Astro.props;
const t = useTranslations(locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO locale={locale} title={title} description={description} image={image} type={type} />
    <!-- Fetches the fonts early, so late fonts do not rewrap text and shift the page. -->
    {[firaCodeFont, openSansFont, openSansItalicFont].map((font) => (
      <link rel="preload" href={font} as="font" type="font/woff2" crossorigin />
    ))}
    <!-- Browser tab icons, phone home screen icon and bar color. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#121212" />
    <!-- Lets feed readers find this language's blog feed. -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={t("meta.blogTitle")}
      href={`${localizedPath(locale)}rss.xml`}
    />
    <ThemeScript />
    <!-- Turns page changes into smooth View Transitions. -->
    <ClientRouter />
    <!-- Extra head tags from a page, such as the home page's structured data. -->
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <!-- Hidden until focused, so keyboard users can jump past the navigation. -->
    <a
      href="#main-content"
      class="bg-accent text-on-accent sr-only z-50 rounded-full px-5 py-2 focus:not-sr-only focus:fixed focus:top-4 focus:left-4"
    >
      {t("nav.skipToContent")}
    </a>
    <Header locale={locale} />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <!-- Cookie-free visit counting. It only reports data on the live Vercel site. -->
    <Analytics />
  </body>
</html>
